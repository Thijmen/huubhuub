#!/usr/bin/env bash
# git credential helper for github.com: asks the bot for a GitHub App installation token
# for the repo's owner. Prints nothing (so git carries on without it) when the app has no access.
[ "$1" = get ] || exit 0
[ -n "$BOT_INTERNAL_URL" ] || exit 0

path=""
while IFS= read -r line && [ -n "$line" ]; do
  case "$line" in
    path=*) path="${line#path=}" ;;
  esac
done
owner="${path%%/*}"
case "$owner" in
  "" | *[!A-Za-z0-9-]*) exit 0 ;;
esac

token=$(curl -fsS --max-time 15 -H "authorization: Bearer $BOT_INTERNAL_TOKEN" "$BOT_INTERNAL_URL/github/token?owner=$owner&strict=1" 2>/dev/null) || exit 0
[ -n "$token" ] || exit 0
printf 'username=x-access-token\npassword=%s\n' "$token"
