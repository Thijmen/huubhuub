# --- Telegram ---
# Token from @BotFather
TELEGRAM_BOT_TOKEN=
# Comma-separated Telegram user IDs allowed to use the bot (send /whoami to the bot to find yours).
# Optional here: you can also manage the allowlist in the admin UI.
ALLOWED_USER_IDS=
# auto: each new conversation gets its own Telegram topic (private chats need Threaded Mode in @BotFather,
# groups need topics enabled). off: one conversation per chat.
THREAD_MODE=auto
# draft: private chats stream replies as a live Telegram draft with a stop button, then send the final
# message. edit: update one message in place (groups always do this).
TELEGRAM_STREAMING=draft
# Minutes to wait for an answer when the agent asks a question (default 10).
QUESTION_TIMEOUT_MINUTES=
# IANA time zone for scheduled prompts, e.g. Europe/Amsterdam. Defaults to the server's time zone.
SCHEDULE_TIMEZONE=
# Minutes between automatic pulls of skill repos added in the admin UI (default 60, 0 = only on startup and on demand).
SKILL_SYNC_INTERVAL_MINUTES=

# --- Admin UI ---
# Token for signing in. If empty, one is generated, stored in /data and printed in the startup log.
ADMIN_TOKEN=
ADMIN_PORT=8080
ADMIN_HOST=0.0.0.0
# Public URL, used only in the startup log, e.g. https://bot-admin.example.com
ADMIN_PUBLIC_URL=

# --- Phone app ---
# The app's API. Unlike the admin UI it's meant to be reachable from phones: put a TLS proxy in front of it.
# 0 turns the app API off.
APP_PORT=8081
APP_HOST=0.0.0.0
# Where phones reach the app API, e.g. https://huub.example.com. Needed for invites (/app in Telegram, or the
# People page in the admin UI).
APP_PUBLIC_URL=
# Where the invite page sends people who don't have the app installed yet. Defaults to the official Android
# app (the newest APK on the app-android GitHub release), which works with any server.
APP_DOWNLOAD_URL=

# --- OpenCode ---
# Optional default model as provider/model, e.g. anthropic/claude-sonnet-4-5 or openrouter/anthropic/claude-sonnet-4
DEFAULT_MODEL=
# Optional model that reviews replies for things to remember, for users with automatic memory.
# Empty uses the conversation's own model. Also settable in the admin UI.
MEMORY_MODEL=
# Optional default agent (build, plan, ...)
DEFAULT_AGENT=
# trace | debug | info | warn | error | fatal
OPENCODE_LOG_LEVEL=warn
# OpenCode runs as an `opencode serve` child process. Its web UI (sessions, files, terminal) is opened from the
# admin UI with a one-time sign-in link, so you don't normally need the password.
OPENCODE_PORT=4196
OPENCODE_HOST=0.0.0.0
# Where browsers reach the web UI, if not the admin's host on OPENCODE_PORT, e.g. https://bot-opencode.example.com
OPENCODE_PUBLIC_URL=
# Basic-auth password (user "opencode"). If empty, one is generated and stored in /data.
OPENCODE_SERVER_PASSWORD=

# Provider API keys: set any you use; /model lists whatever becomes available.
# You can also paste keys into the admin UI instead.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=
# OpenCode Zen / Go
OPENCODE_API_KEY=

# --- Voice (Amazon Transcribe Streaming) ---
# Leave the AWS credentials empty to disable voice notes.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=eu-west-1
# Fixed language code (e.g. en-US, nl-NL); leave empty to auto-detect from TRANSCRIBE_LANGUAGE_OPTIONS
TRANSCRIBE_LANGUAGE=
TRANSCRIBE_LANGUAGE_OPTIONS=en-US,nl-NL

# Behind a TLS-intercepting proxy, mount your CA bundle and point to it:
# NODE_EXTRA_CA_CERTS=/certs/ca.pem
